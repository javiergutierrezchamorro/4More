// 4More.rc — recursos del visor (Build 5.9.13)
//
// 5.9.13: LOS DIÁLOGOS CAMBIAN. View > Wrap to Fixed Width deja de reusar
// la plantilla IDD_GOTO (título "Go To", radios Line/Offset sin función,
// texto de ayuda del Go To) y estrena IDD_WRAPWIDTH propia: título "Wrap to
// Fixed Width", etiqueta "Columns:", ayuda propia y botones OK/Cancel. El
// control nuevo IDC_WRAP_COLS (1109) vive en resource.h. Ni menú ni
// aceleradores cambian. El manifest sube a 5.9.13.0.0.
//
// 5.9.12: NI MENÚ NI ACELERADORES NI DIÁLOGOS CAMBIAN. La revisión es del
// .cpp (columna deseada del caret recortada al display end; TV_WrapChars
// pinza a >= 1). El manifest sube a 5.9.12.0.0.
//
// 5.9.11: NI MENÚ NI ACELERADORES NI DIÁLOGOS CAMBIAN. La revisión es del
// .cpp (VK_UP/DOWN/END usan TV_DispEnd, paridad con el refactoring de
// 5.9.10) y del .vcxproj (toolset v145→v143, Debug preprocessor defs +
// stdcpp17). El manifest sube a 5.9.11.0.0.
//
// 5.9.10: NI MENÚ NI ACELERADORES NI DIÁLOGOS CAMBIAN. Limpieza del .cpp:
// los recortes CR/LF y el cálculo del ancho de wrap pasan a helpers únicos
// (TV_DispEnd, TV_WrapChars) y TV_SetText deja de refrescar los rangos de
// scroll dos veces por entrega. El manifest sube a 5.9.10.0.0.
//
// 5.9.9: NI MENÚ NI ACELERADORES NI DIÁLOGOS CAMBIAN. La revisión es del
// .cpp: corrupción de pila en el índice paralelo (aOrphan[3] con 4 trozos),
// doble free del job si la ventana muere durante la carga, columna de
// offsets hex ausente en la primera carga y scrollbar vertical desfasada
// tras alternar wrap. El manifest sube a 5.9.9.0.0.
//
// 5.9: NI MENÚ NI ACELERADORES NI DIÁLOGOS CAMBIAN. La revisión es del
// .cpp: la línea con bookmark se pinta con fondo azul (siempre, con o sin
// line numbers, hex incluido) y la bola azul también se dibuja en la
// columna de la vista hex. El manifest sube a 5.9.0.0.
//
// 5.8: MENÚ, ACELERADORES Y MANIFEST CAMBIAN. View añade dos opciones
// (Highlight Current Line, ESC to Exit) y File > Exit gana el acelerador
// Alt+X (el menú lo anuncia). El manifest sube a 5.8.0.0.
//
// 5.5: NI MENÚ NI ACELERADORES NI DIÁLOGOS CAMBIAN. La revisión es del .cpp:
// las últimas filas volvían a quedarse sin número de línea (el bucle del
// gutter comparaba coordenadas del padre contra el alto del control) y el
// repaint de selección/caret pasa a ser mínimo. El manifest sube a 5.5.0.0.
//
// 4.0: AÑADE 3 ITEMS AL MENÚ VIEW (Greenbar, Ruler, Wrap to Fixed Width).
// Los 3 IDs nuevos (ID_VIEW_GREENBAR, ID_VIEW_RULER, ID_VIEW_WRAPWIDTH)
// viven en resource.h. El manifest sube a 4.0.0.0.
//
// 3.20: NI MENÚ NI ACELERADORES NI RECURSOS CAMBIAN. La revisión es del
// .cpp: corrección de bugs (PostMessage sin check, g_qwSearchResult non-volatile,
// hEdit null check, POLYTEXTW cap) y simplificación de código. El manifest puede
// subir a 3.20.0.0 (opcional, cosmético).
//
// 3.19: NI MENÚ NI ACELERADORES NI RECURSOS CAMBIAN. La revisión es del
// .cpp: double-decode eliminado (/hex /utf8 decodifican directo en el worker)
// y chunks de lectura de 4 MB (era 1 MB). El manifest puede subir a 3.19.0.0.
//
// 3.18: NI MENÚ NI ACELERADORES NI RECURSOS CAMBIAN. La revisión es del
// .cpp: con Word Wrap activado, el texto se limita a 2 MB (CB_WRAP_TEXT_MAX)
// porque el control EDIT recalcula todos los soft breaks sincrónicamente y
// 26 MB helaba la ventana ~10 segundos. Sin wrap el límite sigue en 32 MB.
// El manifest puede subir a 3.18.0.0 (opcional, cosmético).
//
// 3.17: NI MENÚ NI ACELERADORES NI RECURSOS CAMBIAN. La revisión es del
// .cpp: con Word Wrap activado, la entrega usa WM_SETTEXT en lugar de
// EM_SETHANDLE porque este último recalcula TODOS los puntos de ruptura
// del texto en una sola llamada síncrona, helando la ventana varios
// segundos para 26 MB. El manifest puede subir a 3.17.0.0 (opcional).
//
// 3.16: NI MENÚ NI ACELERADORES NI RECURSOS CAMBIAN. La revisión es del
// .cpp: el troceo de la entrega (3.14-3.15, EM_REPLACESEL) era cuadrático
// en el buffer acumulado del control EDIT y hacía que un TXT de 30 MB
// tardara ~8 segundos sólo en la entrega. 3.16 elimina el troceo y vuelve
// a la entrega monolítica EM_SETHANDLE (O(1)), con la barra pintada a
// 100% antes del swap. El manifest puede subir a 3.16.0.0 (opcional,
// cosmético: la revisión es toda del .cpp).
//
// 3.15: NI MENÚ NI ACELERADORES NI RECURSOS CAMBIAN. La revisión es del
// .cpp: la entrega troceada de 3.14 excluía Word Wrap, y con wrap activo
// (recordado en 4More.ini) la página grande seguía entrando monolítica
// detrás de la señal de barra llena — la misma barra helada de siempre.
// 3.15 quita la exclusión: el reenvuelto del EDIT es incremental desde el
// punto de edición igual que su tabla de líneas, así que el troceo vale
// también con wrap y la barra camina permille real en TODOS los caminos
// de página grande. Compilar junto al 4More.cpp 3.15 (APP_VERSION ya
// dice "3.15"); manifest a 3.15.0.0.
//
// 3.14: NI MENÚ NI ACELERADORES NI RECURSOS CAMBIAN. La revisión es del
// .cpp: la entrega de páginas grandes se trocea y se bombea (EM_REPLACESEL
// de 1M de caracteres con bomba de mensajes entre trozos) y la barra de
// progreso publica permille real durante TODA la carga — también en el
// tramo de entrega que antes congelaba el hilo UI con la barra llena.
// Compilar junto al 4More.cpp 3.14 (APP_VERSION ya dice "3.14");
// manifest a 3.14.0.0.
//
// 3.13: NI MENÚ NI ACELERADORES NI RECURSOS CAMBIAN. La revisión es solo
// del .cpp: el worker publica CADA tic de trozo sin throttle (el throttle
// de 62 ms se comía todos los tics de una lectura rápida y la barra no
// tenía nada que animar) y el sondeo baja a 16 ms. Único cambio visible
// en recursos: el comentario de abajo, porque EnsureRecentMenu ya NO
// inserta separador propio (dos separadores seguidos en File). Compilar
// junto al 4More.cpp 3.13 (APP_VERSION ya dice "3.13"); manifest a 3.13.0.0.
// del .cpp: la barra de progreso ya no viaja por mensajes. El worker
// publica el permille en un campo atómico del job y la UI lo sondea
// con un WM_TIMER de 50 ms pintando en el acto; ApplyLoadResult pinta
// además el estado final (100%) ANTES de la entrega EM_SETHANDLE.
// Tres revisiones publicando el permille correcto por PostMessage se
// clavaban igual en la máquina real: la petición de repintado perdía
// la carrera contra la cola. Trozos de lectura de 1 MB (antes 4 MB).
// Compilar junto al 4More.cpp 3.12 (APP_VERSION ya dice "3.12");
// manifest a 3.12.0.0.
//
// 3.09: NI MENÚ NI ACELERADORES NI RECURSOS CAMBIAN. La revisión es solo
// del .cpp: la vista hex ya pinta su primera pantalla mientras carga (con
// columna de offsets) y la barra de progreso sube al empezar la lectura
// larga, no tras el primer trozo. Compilar junto al 4More.cpp 3.09
// (APP_VERSION ya dice "3.09"); manifest a 3.09.0.0.
//
// 3.08: NI MENÚ NI ACELERADORES CAMBIAN. La revisión toca el .cpp (barra
// de progreso en la parte derecha de la status bar, primera pintada del
// principio del fichero mientras carga, lecturas partidas de 64 bits en
// x86) y el manifest (versión 3.08.0.0, GUIDs supportedOS de Windows 7/8).
// Compilar junto al 4More.cpp 3.08 (APP_VERSION ya dice "3.08").
//
// 3.06: NI MENÚ NI ACELERADORES CAMBIAN. Revisión a fondo del .cpp
// (columna de líneas, PgDn en Hex, foco tras Word Wrap, Find más rápido).
// Compilar junto al 4More.cpp 3.06 (APP_VERSION ya dice "3.06").
//
// 3.05: ACELERADORES DE FUENTE CON GEMELAS SHIFT. TranslateAccelerator
// compara Shift/Ctrl/Alt de forma EXACTA y en los teclados donde '+' y '-'
// viven detrás de Shift (el estadounidense, entre otros) Ctrl++/Ctrl+-
// llegaban como VK_OEM_PLUS/MINUS con Shift pulsado: la entrada con sólo
// CONTROL no saltaba NUNCA. Ahora cada una tiene su gemela CONTROL|SHIFT;
// Ctrl+= a secas y el numpad siguen cubiertos. El About ya no mezcla
// idiomas ("paginas" pasa a "pages"). Compilar junto al 4More.cpp 3.05
// (APP_VERSION ya dice "3.05") y el About lo mostrará solo.
//
// 3.04: NI MENÚ NI ACELERADORES CAMBIAN. La segunda pasada de revisión fue
// para el .cpp (la pasada CRLF escanea una vez, detectores más delgados,
// dos gemelos menos) y para correcciones que no tocan recursos. Compilar
// junto al 4More.cpp 3.04 (APP_VERSION ya dice "3.04") y el About lo
// mostrará solo.
//
// 3.03: Next/Previous Page anuncian PgDn/PgUp (las teclas las atiende
// el subclass del EDIT con semántica de pager: la página se desplaza
// mientras pueda y en su borde carga la página siguiente/anterior del
// fichero; Ctrl+PgDn/Ctrl+PgUp siguen valiendo como salto directo).
// Los aceleradores VK_NEXT/VK_PRIOR SALEN de la tabla: interceptaban
// la tecla antes de que el subclass pudiera desplazarse. El Go To
// pierde ES_NUMBER: bloqueaba teclear el 0x que el propio cartel
// anuncia (ParseU64 valida de verdad). El resto del fichero queda
// como estaba; compilar junto al 4More.cpp 3.03 (APP_VERSION ya dice
// "3.03") y el About lo mostrará solo.
//
// Sin ficheros del asistente de Visual Studio (2.97): ni targetver.h ni
// afxres.h, que no forman parte del SDK. Sólo windows.h + resource.h:
// compila con rc.exe (MSVC) y con windres (MinGW-w64). Guardar en UTF-8
// con BOM y finales de línea CRLF.
//
// MANIFEST (2.99): "1 24" embebe 4More.manifest como RT_MANIFEST de id 1.
// La dependencia de Common-Controls 6.0 es lo que hace que los botones,
// radios y checkboxes de los diálogos pinten con el look moderno de
// Windows (sin él, el sistema sirve la versión 5 de 1995). supportedOS
// (8.1/10/11) y dpiAware van en el mismo fichero.
//
// OJO, PROYECTOS MSVC: Visual Studio incrusta POR DEFECTO su propio
// manifiesto (UAC) con el MISMO id de recurso 1 y el MISMO idioma
// (0x0409). En cuanto este .rc también trae el suyo, el enlace muere con:
//     "recurso duplicado. Tipo:MANIFEST, nombre: 1, idioma: 0x0409"
//     "error durante la conversión a COFF: archivo no válido o dañado"
//     (CVT1100 / LNK1123; el "dañado" es engañoso: nada está dañado,
//      sólo hay DOS manifiestos id 1).
// Dos arreglos, a elegir:
//   A) Propiedades → Enlazador → Archivo de manifiesto → Crear
//      manifiesto = No (/MANIFEST:NO). RECOMENDADO: el del .rc queda
//      como único y windres/MinGW sigue igual.
//   B) Propiedades → Recursos → Preprocesador → Definiciones de
//      preprocesador: añadir NO_RC_MANIFEST (la línea de abajo se
//      desactiva), y que VS incruste el manifiesto él mismo:
//      Propiedades → Herramienta Manifiesto → Manifiesto de entrada
//      = 4More.manifest.
// MinGW no se ve afectado: windres no genera manifiesto propio.

#include "windows.h"
#include "resource.h"


/////////////////////////////////////////////////////////////////////////////
// Manifest

#ifndef NO_RC_MANIFEST
1 24 "4More.manifest"
#endif


/////////////////////////////////////////////////////////////////////////////
// Menú principal

IDC_MY4MORE MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...\tCtrl+O",                    ID_FILE_OPEN
        MENUITEM "&View Clipboard as File",             ID_FILE_VIEWCLIP
        MENUITEM "&Alternate Data Streams...",          ID_FILE_ADS
        MENUITEM SEPARATOR
        // Recent Files (2.96) se inserta aquí en ejecución: EnsureRecentMenu
        // añade el popup antes de Exit (3.13: SIN separador propio — el
        // separador estático de arriba ya separa el bloque del popup).
        MENUITEM "E&xit\tAlt+X",                        ID_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy\tCtrl+C",                       ID_COPY
        MENUITEM "Select &All\tCtrl+A",                 ID_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "&Find...\tCtrl+F",                    ID_FIND
        MENUITEM "Find &Next\tF3",                      ID_FINDNEXT
        MENUITEM SEPARATOR
        MENUITEM "&Bookmark\tF2",                       ID_EDIT_BOOKMARK
        MENUITEM "&Next Bookmark\tShift+F2",            ID_EDIT_NEXTBOOKMARK
        MENUITEM "&Previous Bookmark\tCtrl+F2",         ID_EDIT_PREVBOOKMARK
    END
    POPUP "&Search"
    BEGIN
        MENUITEM "&Go To...\tCtrl+G",                   ID_SEARCH_GOTO
        MENUITEM "Find &Bytes...\tCtrl+Shift+F",        ID_SEARCH_BYTES
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&ANSI",                               ID_VIEW_ANSI
        MENUITEM "&UTF-8",                              ID_VIEW_UTF8
        MENUITEM "&Unicode (UTF-16 LE)",                ID_VIEW_UNICODE
        MENUITEM "UTF-16 &BE",                          ID_VIEW_UTF16BE
        MENUITEM "&EBCDIC",                             ID_VIEW_EBCDIC
        MENUITEM "&Hexadecimal",                        ID_VIEW_HEX
        MENUITEM SEPARATOR
        MENUITEM "&Next Page\tPgDn",                    ID_VIEW_NEXTPAGE
        MENUITEM "&Previous Page\tPgUp",                ID_VIEW_PREVPAGE
        MENUITEM "&Refresh\tF5",                        ID_VIEW_REFRESH
        MENUITEM "&Tail File\tCtrl+T",                  ID_VIEW_TAIL
        MENUITEM "&Line Numbers",                       ID_VIEW_LINENUMS
        MENUITEM "&Word Wrap",                          ID_VIEW_WRAP
        MENUITEM "Wrap to &Fixed Width...",              ID_VIEW_WRAPWIDTH
        MENUITEM "&Greenbar",                            ID_VIEW_GREENBAR
        MENUITEM "&Ruler",                              ID_VIEW_RULER
        MENUITEM "&Highlight Current Line",              ID_VIEW_HILITE
        MENUITEM "ESC to E&xit",                         ID_VIEW_ESCEXIT
        MENUITEM SEPARATOR
        MENUITEM "Font &+\tCtrl++",                     ID_VIEW_FONTPLUS
        MENUITEM "Font &-\tCtrl+-",                      ID_VIEW_FONTMINUS
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About 4More...",                      ID_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
// Aceleradores

IDC_MY4MORE ACCELERATORS
BEGIN
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL, NOINVERT
    "X",            ID_EXIT,                VIRTKEY, ALT, NOINVERT
    "C",            ID_COPY,                VIRTKEY, CONTROL, NOINVERT
    "A",            ID_SELECTALL,           VIRTKEY, CONTROL, NOINVERT
    "F",            ID_FIND,                VIRTKEY, CONTROL, NOINVERT
    "G",            ID_SEARCH_GOTO,         VIRTKEY, CONTROL, NOINVERT
    "T",            ID_VIEW_TAIL,           VIRTKEY, CONTROL, NOINVERT
    "F",            ID_SEARCH_BYTES,        VIRTKEY, CONTROL, SHIFT, NOINVERT
    VK_F2,          ID_EDIT_BOOKMARK,       VIRTKEY, NOINVERT
    VK_F2,          ID_EDIT_NEXTBOOKMARK,   VIRTKEY, SHIFT, NOINVERT
    VK_F2,          ID_EDIT_PREVBOOKMARK,   VIRTKEY, CONTROL, NOINVERT
    VK_F3,          ID_FINDNEXT,             VIRTKEY, NOINVERT
    VK_F5,          ID_VIEW_REFRESH,        VIRTKEY, NOINVERT
    // 3.03: VK_NEXT / VK_PRIOR (con o sin CONTROL) ya NO están aquí: un
    // acelerador intercepta la tecla en el bucle de mensajes, ANTES de
    // que el subclass del EDIT pueda decidir si toca desplazar la página
    // en pantalla o cargar la siguiente. Son teclas del pager, no
    // comandos: las atiende el subclass (el menú View > Next/Previous
    // Page sigue funcionando por ratón, vía WM_COMMAND).
    // Fuente: fila principal (= / _) y numpad (+ / -), sólo por la tabla:
    // el acelerador responde SIEMPRE que el foco esté en el programa,
    // así que la rama gemela del subclass se retiró en 3.03 (rama muerta).
    // 3.05: TranslateAccelerator exige el estado EXACTO de Shift/Ctrl/Alt;
    // un Ctrl++ de verdad (Shift dentro para producir '+') no saltaba con
    // la variante CONTROL a secas: cada fila principal lleva su gemela
    // CONTROL|SHIFT. Ctrl+= a secas y el numpad siguen cubiertos.
    VK_ADD,         ID_VIEW_FONTPLUS,       VIRTKEY, CONTROL, NOINVERT
    VK_SUBTRACT,    ID_VIEW_FONTMINUS,      VIRTKEY, CONTROL, NOINVERT
    VK_OEM_PLUS,    ID_VIEW_FONTPLUS,       VIRTKEY, CONTROL, NOINVERT
    VK_OEM_PLUS,    ID_VIEW_FONTPLUS,       VIRTKEY, CONTROL, SHIFT, NOINVERT
    VK_OEM_MINUS,   ID_VIEW_FONTMINUS,      VIRTKEY, CONTROL, NOINVERT
    VK_OEM_MINUS,   ID_VIEW_FONTMINUS,      VIRTKEY, CONTROL, SHIFT, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
// Iconos (opcionales: sin los .ico el enlazador recurre al icono de Windows)

IDI_MY4MORE           ICON                   "4More.ico"
IDI_SMALL             ICON                   "small.ico"


/////////////////////////////////////////////////////////////////////////////
// Cuadro Acerca de
// Fuente "MS Shell Dlg 2" (Tahoma) desde 2.99: la clásica de Common-Controls 6.

IDD_ABOUTBOX DIALOGEX 22, 17, 230, 102
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU | WS_POPUP
CAPTION "About 4More"
FONT 8, "MS Shell Dlg 2", 400, 0, 0x1
BEGIN
    ICON            IDI_MY4MORE, IDC_STATIC, 10, 10, 21, 20, SS_REALSIZECONTROL
    LTEXT           "4More", IDC_STATIC, 42, 10, 178, 8, SS_NOPREFIX
    LTEXT           "", IDC_ABOUT_VERSION, 42, 22, 178, 8
    LTEXT           "", IDC_ABOUT_BUILD, 42, 34, 178, 8
    LTEXT           "", IDC_ABOUT_COMPILER, 42, 46, 178, 8
    LTEXT           "Read-only file viewer: pages, encodings, hex.", IDC_STATIC, 42, 58, 178, 8
    DEFPUSHBUTTON   "OK", IDOK, 90, 82, 50, 14, WS_GROUP
END


/////////////////////////////////////////////////////////////////////////////
// Cuadro Ir A

IDD_GOTO DIALOGEX 0, 0, 264, 92
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU | WS_POPUP
CAPTION "Go To"
FONT 8, "MS Shell Dlg 2", 400, 0, 0x1
BEGIN
    LTEXT           "Go to:", IDC_STATIC, 12, 12, 40, 8
    CONTROL         "&Line", IDC_GOTO_LINE, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 60, 10, 40, 10
    CONTROL         "&Offset", IDC_GOTO_OFFS, "Button", BS_AUTORADIOBUTTON, 110, 10, 48, 10
    EDITTEXT         IDC_GOTO_EDIT, 12, 28, 240, 14, ES_AUTOHSCROLL
    LTEXT           "Line: 1..N of the page on screen. Offset: absolute byte (0x... hex accepted).", IDC_STATIC, 12, 48, 240, 16
    DEFPUSHBUTTON   "&Go", IDOK, 152, 70, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 206, 70, 50, 14
END


/////////////////////////////////////////////////////////////////////////////
// Cuadro Buscar Bytes

IDD_FINDBYTES DIALOGEX 0, 0, 264, 116
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU | WS_POPUP
CAPTION "Find Bytes"
FONT 8, "MS Shell Dlg 2", 400, 0, 0x1
BEGIN
    LTEXT           "&Pattern:", IDC_STATIC, 12, 12, 40, 8
    EDITTEXT         IDC_BYTES_EDIT, 60, 10, 192, 14, ES_AUTOHSCROLL
    CONTROL         "&Hex pairs (e.g. 4D 5A)", IDC_BYTES_HEX, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 60, 30, 192, 10
    LTEXT           "Text mode: the bytes of the text as typed. Hex mode: pairs, spaces optional.", IDC_STATIC, 12, 48, 240, 16
    LTEXT           "The WHOLE file on disk is scanned in a worker thread (ESC cancels).", IDC_STATIC, 12, 64, 240, 16
    DEFPUSHBUTTON   "&Find", IDOK, 152, 94, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 206, 94, 50, 14
END


/////////////////////////////////////////////////////////////////////////////
// Cuadro Ajuste de Línea a Ancho Fijo
// 5.9.13: plantilla propia. Desde la V4 el diálogo reusaba IDD_GOTO y el
// usuario veía el título "Go To", la etiqueta "Go to:" y los radios
// Line/Offset, que aquí no pinta nadie. La lógica (WrapWidthProc) no
// cambia: ParseU64, cap a 10000, vacío o basura = ancho fijo desactivado.

IDD_WRAPWIDTH DIALOGEX 0, 0, 210, 68
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU | WS_POPUP
CAPTION "Wrap to Fixed Width"
FONT 8, "MS Shell Dlg 2", 400, 0, 0x1
BEGIN
    LTEXT           "&Columns:", IDC_STATIC, 12, 14, 40, 8
    EDITTEXT        IDC_WRAP_COLS, 60, 12, 60, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Wrap every line at this many columns (10-10000). 0 turns fixed width off.", IDC_STATIC, 12, 34, 186, 16
    DEFPUSHBUTTON   "OK", IDOK, 96, 50, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 152, 50, 50, 14
END


/////////////////////////////////////////////////////////////////////////////
// Tabla de cadenas

STRINGTABLE
BEGIN
    IDS_APP_TITLE           "4More"
    IDC_MY4MORE             "4More"
END


/////////////////////////////////////////////////////////////////////////////
// TEXTINCLUDE (compatibilidad con el editor de recursos)

#ifdef APSTUDIO_INVOKED
1 TEXTINCLUDE
BEGIN
    "resource.h\0"
END

2 TEXTINCLUDE
BEGIN
    "#include ""windows.h""\r\n"
    "\0"
END

3 TEXTINCLUDE
BEGIN
    "\r\n"
    "\0"
END

#endif    // APSTUDIO_INVOKED

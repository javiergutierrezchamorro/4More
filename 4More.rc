IDD_FREEZECOLS DIALOGEX 0, 0, 210, 68
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU | WS_POPUP
CAPTION "Freeze Columns"
FONT 8, "MS Shell Dlg 2", 400, 0, 0x1
BEGIN
    LTEXT           "&Columns:", IDC_STATIC, 12, 14, 40, 8
    EDITTEXT        IDC_FREEZE_COLS, 60, 12, 60, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Keep this many columns fixed while scrolling horizontally (0 = off, max 200).", IDC_STATIC, 12, 34, 186, 16
    DEFPUSHBUTTON   "OK", IDOK, 96, 50, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 152, 50, 50, 14
END


